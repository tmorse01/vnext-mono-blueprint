{
  "name": "@vnext/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/database.d.ts",
      "import": "./dist/types/database.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/cli.js migrate",
    "seed": "node dist/cli.js seed",
    "reset": "node dist/cli.js reset",
    "schema:check": "node dist/cli.js schema:check"
  },
  "dependencies": {
    "kysely": "catalog:",
    "tarn": "catalog:",
    "tedious": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
