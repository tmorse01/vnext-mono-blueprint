# syntax=docker/dockerfile:1.7
# Build from the repository root: docker build -f infrastructure/containers/Dockerfile.lending-api .
# Pinning every stage keeps native dependencies and runtime output linux/amd64.
FROM --platform=linux/amd64 node:24.22.0-bookworm-slim AS build
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@12.13.0 --activate

COPY package.json pnpm-workspace.yaml .npmrc turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter '@vnext/lending-api...' build
RUN pnpm --filter '@vnext/lending-api' --prod deploy --legacy /out

FROM --platform=linux/amd64 node:24.22.0-bookworm-slim AS runtime
ENV NODE_ENV=production LENDING_API_PORT=3000
WORKDIR /app
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --home-dir /app app
COPY --from=build --chown=10001:10001 /out/ ./
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
